{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.dev*)",
      "Read(//**/.env.stg)",
      "Read(//**/.env.stag*)",
      "Read(//**/.env.prod*)",
      "Read(//**/.envrc)",
      "Read(//**/.aws/**)",
      "Edit(//**/.aws/**)",
      "Read(//**/.ssh/**)",
      "Edit(//**/.ssh/**)",
      "Read(//**/*.tfstate)",
      "Edit(//**/*.tfstate)",
      "Read(//**/*.tfstate.*)",
      "Edit(//**/*.tfstate.*)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.pki/**)",
      "Edit(~/.pki/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Edit(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.cargo/credentials.toml)",
      "Edit(~/.cargo/credentials.toml)",
      "Read(~/.copilot/**)",
      "Edit(~/.copilot/**)",
      "Read(~/.lesshst)",
      "Edit(~/.lesshst)",
      "Read(~/.viminfo)",
      "Edit(~/.viminfo)"
    ],
    "ask": [
      "Bash(sh *)",
      "Bash(bash *)",
      "Bash(zsh *)",
      "Bash(fish *)",
      "Bash(ash *)",
      "Bash(csh *)",
      "Bash(nu *)",
      "Bash(perl *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(ruby *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(netcat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(gh *)",
      "Bash(terraform apply *)",
      "Bash(terraform state *)",
      "Edit(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(//**/.env.*)",
      "Edit(//**/.envrc)",
      "Edit(/.git/**)",
      "Read(~/.*history*)",
      "Edit(~/.*history*)",
      "Read(~/.gradle/gradle.properties)",
      "Edit(~/.gradle/gradle.properties)",
      "Read(~/.m2/settings.xml)",
      "Edit(~/.m2/settings.xml)"
    ]
  },
  "model": "global.anthropic.claude-opus-4-6-v1[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/discord-notify.sh \"🚦 Ask\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/discord-notify.sh --min-duration 30 \"✨ Done\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/bin/statusline"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
